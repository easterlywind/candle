# =====================================================================
# CẤU HÌNH THÔNG BÁO TELEGRAM (Server-side Secrets)
# Dùng cho server Node.js hoặc Settings -> Secrets trên Google AI Studio
# =====================================================================

# 1. Token bot lấy từ @BotFather (dạng 123456789:AAFn_...)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Chat ID nhận thông báo đơn hàng (lấy từ @userinfobot hoặc @getmyid_bot)
TELEGRAM_CHAT_ID=your_chat_id_here

# =====================================================================
# CẤU HÌNH SHOP FRONTEND (Tùy chọn)
# =====================================================================

# Username Telegram của xưởng (hiển thị footer và tạo link t.me/...)
VITE_TELEGRAM_SHOP_USERNAME=latelier_candle_bot

# Cổng khởi chạy máy chủ production (Cloud Run mặc định 8080)
PORT=8080
